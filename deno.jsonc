{
	"name": "@tadashi/skreen",
	"version": "3.0.9",
	"description": "Render HTML to PNG screenshots or a selectable-text PDF using a Rust core.",
	"license": "MIT",
	"runtime": ["deno"],
	"exports": {
		".": "./mod.ts"
	},
	"publish": {
		"include": [
			"mod.ts",
			"wasm/",
			"README.md"
		]
	},
	"tasks": {
		"build": "deno run --allow-run --allow-write --allow-read --allow-ffi --allow-env build.ts",
		"test": "deno test --allow-read --allow-ffi --allow-net --allow-run --allow-env --allow-write mod_test.ts",
		"fmt:chk": "deno fmt --check"
	},
	"nodeModulesDir": "auto",
	"imports": {
		"@fulgur-rs/cli": "npm:@fulgur-rs/cli@0.16.0",
		"@std/assert": "jsr:@std/assert@1.0.19",
		"@std/encoding": "jsr:@std/encoding@1.0.10"
	},
	"fmt": {
		"useTabs": true,
		"indentWidth": 4,
		"lineWidth": 120,
		"semiColons": true,
		"singleQuote": false,
		"proseWrap": "always",
		"include": [
			"mod*.ts",
			"build.ts",
			"*.jsonc",
			"*.md",
			"*.yml",
			"*.yaml"
		]
	},
	"lint": {
		"include": [
			"mod*.ts",
			"build.ts"
		],
		"rules": {
			"tags": ["recommended"],
			"include": [
				"no-inferrable-types"
			]
		}
	}
}
